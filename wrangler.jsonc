
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-mcp-server-bharat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MCP_RESOURCE": "http://localhost:8788/mcp"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "aa670610e553499a8c19f832f1dc488d"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
