{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-mcp-server-bharat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MCP_RESOURCE": "https://youtube-mcp-server-bharat.klassyfic.workers.dev/mcp",
    "TTS_API_URL": "https://klassyfic-video-renderer-z4mltyuxlq-el.a.run.app/v1/audio/speech",
    "TTS_MODEL": "google-cloud-tts",
    "TTS_VOICE": "mr-IN-Chirp3-HD-Achird"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "aa670610e553499a8c19f832f1dc488d"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
