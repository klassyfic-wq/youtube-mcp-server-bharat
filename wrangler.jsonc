{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-mcp-server-bharat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": true,
  "vars": {
    "MCP_RESOURCE": "https://youtube-mcp-server-bharat.klassyfic.workers.dev/mcp"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "aa670610e553499a8c19f832f1dc488d"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  },
  "previews": {
    "vars": {
      "MCP_RESOURCE": "https://feature-gcp-cloud-run-renderer-youtube-mcp-server-bharat.klassyfic.workers.dev/mcp"
    },
    "kv_namespaces": [
      {
        "binding": "OAUTH_KV",
        "id": "ee9f907619fe41238aa1b69852aa57ff"
      }
    ]
  }
}
